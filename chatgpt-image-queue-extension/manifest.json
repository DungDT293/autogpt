{
  "manifest_version": 3,
  "name": "ChatGPT Image Prompt Queue",
  "version": "0.3.2",
  "description": "Queue prompts and submit them sequentially in ChatGPT image mode.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
  "action": {
    "default_title": "Image Prompt Queue",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": [
        "src/config.js",
        "src/dom-utils.js",
        "src/storage.js",
        "src/chatgpt-automation.js",
        "src/image-inputs.js",
        "src/queue-runner.js",
        "src/panel.js",
        "content.js"
      ],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
